# Copy to `.env.local` for local development, and add the same three as GitHub Actions
# secrets (Settings → Secrets and variables → Actions) so the deployed site gets them.
# Without them the site still runs; checkout simply says payment is not live yet.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Razorpay → Settings → API Keys (the *public* key id only; rzp_test_… while you test)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# The Razorpay *secret* is never put here. It lives only in Supabase:
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=...
